region     = "eu-west-1"
subnet_ids = ["subnet-0123456789abcdef0", "subnet-0fedcba9876543210"]

tilebox_api_key_secret_arn    = "arn:aws:secretsmanager:eu-west-1:123456789012:secret:tilebox-api-key-example"
tilebox_api_key_rollout_marker = "replace-with-the-current-secret-version-id"

environment_variables = {
  TILEBOX_CLUSTER = "replace-with-an-optional-cluster-slug"
}
