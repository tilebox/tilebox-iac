project_id = "replace-with-your-workload-project"
region     = "europe-west1"

network_self_link    = "https://www.googleapis.com/compute/v1/projects/example/global/networks/runner-network"
subnetwork_self_link = "https://www.googleapis.com/compute/v1/projects/example/regions/europe-west1/subnetworks/runner-subnet"

tilebox_api_key_secret_project_id = "replace-with-your-secret-project"
tilebox_api_key_secret_id         = "tilebox-api-key"
# Set this to the current secret version whenever rotation should replace the runner VMs.
tilebox_api_key_rollout_marker = ""

environment_variables = {
  TILEBOX_CLUSTER = "replace-with-an-optional-cluster-slug"
}
